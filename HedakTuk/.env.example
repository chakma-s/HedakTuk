# ============================================
# Food Delivery App — Environment Variables
# Copy this to .env and fill in real values
# ============================================

# ---- App ----
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# ---- Database (PostgreSQL) ----
DATABASE_URL=postgresql://fooddelivery:fooddelivery_dev_2026@localhost:5432/fooddelivery?schema=public

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_dev_2026

# ---- JWT Auth ----
JWT_SECRET=your_jwt_secret_change_this_in_production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your_refresh_secret_change_this_in_production
JWT_REFRESH_EXPIRES_IN=7d

# ---- OTP / SMS ----
SMS_PROVIDER=msg91
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_template_id

# ---- Payment Gateway ----
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ---- Google Maps ----
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ---- Firebase (Push Notifications) ----
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_PRIVATE_KEY=your_firebase_private_key
FIREBASE_CLIENT_EMAIL=your_firebase_client_email

# ---- Cloud Storage (S3 / R2) ----
STORAGE_BUCKET=your_bucket_name
STORAGE_REGION=ap-south-1
STORAGE_ACCESS_KEY=your_access_key
STORAGE_SECRET_KEY=your_secret_key
STORAGE_ENDPOINT=https://your-endpoint.r2.cloudflarestorage.com

# ---- Email ----
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="Food Delivery <noreply@yourapp.com>"

# ---- Frontend URLs (CORS) ----
ADMIN_URL=http://localhost:3001
MOBILE_API_URL=http://localhost:3000
